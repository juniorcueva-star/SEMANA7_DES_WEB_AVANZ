<%- include('partials/head', { title }) %>
<main class="auth-wrap container">
  <div class="row valign-wrapper auth-row">
    <section class="col s12 m6 intro-panel">
      <p class="eyebrow">PORTAL SEGURO</p>
      <h1>Bienvenido de nuevo</h1>
      <p>Accede a tu cuenta para consultar tu perfil y las herramientas disponibles según tu rol.</p>
    </section>
    <section class="col s12 m6">
      <div class="card auth-card"><div class="card-content">
        <span class="card-title">Iniciar sesión</span>
        <form id="signInForm">
          <div class="input-field"><input id="email" name="email" type="email" autocomplete="email" required><label for="email">Correo electrónico</label></div>
          <div class="input-field"><input id="password" name="password" type="password" autocomplete="current-password" required><label for="password">Contraseña</label></div>
          <p id="formMessage" class="message" role="status"></p>
          <button class="btn-large blue darken-3 waves-effect waves-light full-width" type="submit">Ingresar</button>
        </form>
        <p class="center-align signup-hint">¿No tienes cuenta? <a href="/signUp">Regístrate aquí</a></p>
      </div></div>
    </section>
  </div>
</main>
<%- include('partials/footer') %>
<script src="/js/signIn.js"></script>
